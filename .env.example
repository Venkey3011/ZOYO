# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this app is hosted.
APP_URL=http://localhost:3000

# MongoDB Atlas connection URI (Primary database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zoyo?retryWrites=true&w=majority

# Server Port
PORT=3000

# LiveKit Cloud voice server (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
